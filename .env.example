# Local development only (Next reads these into process.env).
# Production values live in wrangler.jsonc `vars` and `wrangler secret put`.
#
# Copy to `.env.local`:
#   cp .env.example .env.local

# Lets /admin open without Cloudflare Access. NEVER set this in production.
DEV_ADMIN=1

# Used for canonical URLs, the sitemap and admin links inside notification emails.
SITE_URL=http://localhost:3477
